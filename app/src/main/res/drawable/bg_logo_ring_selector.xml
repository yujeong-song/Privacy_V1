<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- selected: 링 더 두껍고 더 진하게 -->
    <item android:state_selected="true">
        <shape android:shape="oval">
<!--            <solid android:color="#000000"/> &lt;!&ndash; 안쪽 검정 &ndash;&gt;-->
            <stroke
                android:width="3dp"
                android:color="@color/logo_ring_selected"/>
        </shape>
    </item>

    <!-- pressed: 선택 전이라도 눌렀을 때 잠깐 진해지게 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
<!--            <solid android:color="#000000"/>-->
            <stroke
                android:width="3dp"
                android:color="@color/logo_ring_selected"/>
        </shape>
    </item>

    <!-- default -->
    <item>
        <shape android:shape="oval">
<!--            <solid android:color="#000000"/>-->
            <stroke
                android:width="2dp"
                android:color="@color/logo_ring_normal"/>
        </shape>
    </item>

</selector>