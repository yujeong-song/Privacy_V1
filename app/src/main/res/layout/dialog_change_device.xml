<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:background="@drawable/dialog_background_rounded">

    <ImageView
        android:id="@+id/caution_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/caution_icon"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="13dp"
        android:backgroundTint="@color/dialog_blue"/>

    <TextView
        android:id="@+id/deconnect_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="기존 연결된 차량과 다릅니다. 다시 확인해주세요."
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="@font/roboto_bold"
        android:background="@color/dialog_blue"/>
    <TextView
        android:id="@+id/request_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="다른 차량과 연결 시에는 어플을 다시 시작해야합니다."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginBottom="20dp"
        android:background="@color/dialog_blue"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:background="#AEB6FE"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/dialog_background_rounded">
        <Button
            android:id="@+id/no_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No"
            android:textSize="19sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/roboto_regular"
            android:backgroundTint="@color/dialog_blue"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <!-- 수직선 -->
        <View
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:background="#AEB6FE" />

        <Button
            android:id="@+id/yes_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Yes"
            android:textColor="@color/white"
            android:textSize="17dp"
            android:fontFamily="@font/roboto_regular"
            android:backgroundTint="@color/dialog_blue"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            />
    </LinearLayout>
</LinearLayout>
