<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_selectable">

    <!-- 이 FrameLayout의 selected 상태에 따라 bg_logo_ring_selector가 바뀜 -->
    <FrameLayout
        android:id="@+id/logoRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_logo_ring_selector"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/hyundai"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvMakerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="현대"
        android:textSize="16sp"
        android:textColor="@color/white"/>
</LinearLayout>