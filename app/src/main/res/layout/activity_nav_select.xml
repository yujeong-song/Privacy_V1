<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/start_activity">

    <!-- ACAT 로고 -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="71dp"
        android:layout_marginTop="50dp"
        android:background="#00000000"
        android:contentDescription="Logo"
        android:gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/acat_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/nav_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:text="내비게이션 버전을 \n선택해주세요."
        android:fontFamily="@font/roboto_bold"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo" />

    <LinearLayout
        android:id="@+id/layoutNavigationHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="30dp"
        android:layout_marginStart="27dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:paddingEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nav_title">

        <TextView
            android:id="@+id/nav_set_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="내비게이션 버전 확인하는 방법"
            android:textColor="#B6B8FF"
            android:maxLines="1"
            android:textSize="18sp"/>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/question_mark" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutNavigationHelp">

        <!-- 상단 브랜드 탭 -->
<!--        <LinearLayout-->
<!--            android:id="@+id/brandTabsContainer"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="68dp"-->
<!--            android:orientation="horizontal" />-->
        <HorizontalScrollView
            android:id="@+id/brandTabScrollView"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/brandTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"/>

        </HorizontalScrollView>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#393548"/>

        <!-- 탭에 따라 변경되는 버튼 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/navTypeRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="28dp"
            android:paddingTop="22dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"/>
        <TextView
            android:id="@+id/supportPreparingTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="25dp"
            android:paddingTop="24dp"
            android:paddingEnd="25dp"
            android:text="해당 차종은 현재 지원 준비 중이에요."
            android:textColor="#E1DEE7"
            android:textSize="20sp"
            android:visibility="gone"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_nav_next"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="23dp"
        android:background="@drawable/selector_btn"
        android:clickable="true"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:text="다음"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--    </LinearLayout>-->

</androidx.constraintlayout.widget.ConstraintLayout>