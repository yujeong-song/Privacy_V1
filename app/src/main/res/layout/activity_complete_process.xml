<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.CompleteActivity">

    <!-- ACAT 로고 -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="71dp"
        android:layout_marginTop="50dp"
        android:background="#00000000"
        android:contentDescription="Logo"
        android:gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/acat_logo_spizen_ver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 가운데 아이콘 -->
    <ImageView
        android:id="@+id/completed_icon"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/complete_icon"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="130dp"/>

    <TextView
        android:id="@+id/step_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="Step 1 삭제 완료"
        android:textColor="#798EE5"
        android:textSize="22sp"
        android:fontFamily="@font/roboto_bolded"
        app:layout_constraintTop_toBottomOf="@id/completed_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="26dp"/>

    <TextView
        android:id="@+id/deleting_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제가 완료되었습니다.\n자동 재시작이 진행됩니다."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:lineSpacingExtra ="5dp"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        app:layout_constraintTop_toBottomOf="@id/step_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/step_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step  1 / 6"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:lineSpacingExtra ="5dp"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        app:layout_constraintTop_toBottomOf="@id/deleting_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>