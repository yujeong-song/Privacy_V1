<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="71dp"
        android:layout_marginTop="50dp"
        android:background="#00000000"
        android:contentDescription="Logo"
        android:gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/acat_logo_spizen_ver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 가운데 아이콘 -->

    <ImageView
        android:id="@+id/center_icon"
        android:layout_width="347dp"
        android:layout_height="212dp"
        android:src="@drawable/main_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo"
        android:layout_marginTop="130dp"/>

    <ImageButton
        android:id="@+id/reset_menu"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="100dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="15dp"
        android:background="@color/main_background"
        android:contentDescription="Reset Menu"
        android:scaleType="centerInside"
        android:src="@drawable/reset_button"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/roboto_bolded"
        android:text="블루투스 연결을 위해 \n 새로운기기 추가를 눌러주세요."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:lineSpacingExtra ="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/center_icon" />

    <TextView
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" 차량에서 새로운기기 추가를 누르신 후\n 아래 버튼을 눌러주세요. "
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:lineSpacingExtra ="4dp"
        android:fontFamily="@font/roboto_regular"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>

    <Button
        android:id="@+id/checkingButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="23dp"
        android:background="@drawable/button_background_rounded"
        android:clickable="true"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:text="새로운 기기 추가 완료"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sub_title" />

