    <TextView
        android:id="@+id/credit_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:text="사용한 크래딧"
        android:fontFamily="@font/roboto_bolded"
        android:textColor="#BEBEBE"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_crdit" />



    <TextView
        android:id="@+id/credit_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="25dp"
        android:text="0"
        android:fontFamily="@font/roboto_bolded"
        android:textColor="#5975FF"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/credit_label" />

    <View
        android:id="@+id/deleted_line1"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#595959"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@id/credit_num"/>

    <LinearLayout
        android:id="@+id/orderby_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/deleted_line1">

        <!-- 1. 제목 -->
        <TextView
            android:id="@+id/credit_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:text="크레딧 월 별 사용 상세내역"
            android:fontFamily="@font/roboto_bolded"
            android:textColor="#BEBEBE"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 2. 정렬 토글 버튼 -->
        <Button
            android:id="@+id/btnSortAsc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="25dp"
            android:text="오래된 순"/>
    </LinearLayout>


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toBottomOf="@+id/orderby_time"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <!-- 연·월 표시 및 클릭 영역 -->
        <TextView
            android:id="@+id/selectDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YYYY년 MM월 ▼"
            android:fontFamily="@font/roboto_bolded"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:background="?attr/selectableItemBackground"
            />

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- 사용 내역 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/usedHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>