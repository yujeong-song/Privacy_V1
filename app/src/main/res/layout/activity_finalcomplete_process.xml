<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.FinalCompleteActivity">

    <!-- ACAT 로고 -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="71dp"
        android:layout_marginTop="50dp"
        android:background="#00000000"
        android:contentDescription="Logo"
        android:gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/acat_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 가운데 아이콘 -->
    <ImageView
        android:id="@+id/center_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/final_icon"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>

    <TextView
        android:id="@+id/complete_info_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="개인 정보 삭제가 \n 완료되었습니다!"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="@font/roboto_bolded"
        app:layout_constraintTop_toBottomOf="@id/center_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="26dp"/>

    <View
        android:id="@+id/deleted_line1"
        android:layout_width="match_parent"
        android:layout_height="1.5px"
        android:background="#BEBEBE"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@id/complete_info_message"/>

    <LinearLayout
        android:id="@+id/layout_deleted_vehi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/deleted_line1"
        >

        <!-- 왼쪽 Label -->

        <!-- 오른쪽 Value -->
        <TextView
            android:id="@+id/deleted_vehi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="25dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_regular"
            android:text="차량 번호"
            android:textColor="#BEBEBE"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/deleted_line1" />

        <TextView
            android:id="@+id/deleted_vehi_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="25dp"
            android:textColor="@color/white"
            android:text="GV80"
            android:fontFamily="@font/roboto_bolded"
            android:textSize="18sp"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_deleted_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/layout_deleted_vehi"
        >

        <!-- 왼쪽 Label -->
        <TextView
            android:id="@+id/deleted_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제 완료 일시"
            android:layout_weight="1"
            android:textColor="#BEBEBE"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@id/layout_deleted_vehi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"/>

        <!-- 오른쪽 Value -->
        <TextView
            android:id="@+id/deleted_date_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto_bolded"
            android:text="GV80"
            android:layout_marginEnd="25dp"
            android:textSize="18sp"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_deleted_credit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/layout_deleted_date"
        >

        <!-- 왼쪽 Label -->
        <TextView
            android:id="@+id/deleted_credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="월 누적 크레딧"
            android:layout_weight="1"
            android:textColor="#BEBEBE"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@id/deleted_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"/>

        <!-- 오른쪽 Value -->
        <TextView
            android:id="@+id/deleted_credit_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="25dp"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto_bolded"
            android:text="GV80"
            android:textSize="18sp"
            android:layout_marginTop="5dp"/>
    </LinearLayout>



    <View
        android:id="@+id/deleted_line2"
        android:layout_width="match_parent"
        android:layout_height="1.5px"
        android:background="#BEBEBE"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/layout_deleted_credit"/>


        <TextView
        android:id="@+id/final_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="종료 시 안전한 앱 종료를 위해 기기가 재시작 됩니다."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:lineSpacingExtra ="5dp"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        app:layout_constraintTop_toBottomOf="@id/deleted_line2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp"/>

    <Button
        android:id="@+id/complete_Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/button_background_rounded"
        android:clickable="true"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:text="종료하기"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_message" />


</androidx.constraintlayout.widget.ConstraintLayout>