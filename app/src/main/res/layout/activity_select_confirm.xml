    <LinearLayout
        android:id="@+id/layout_deleted_vehi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/deleted_line1"
        >

        <!-- 왼쪽 Label -->
        <TextView
            android:id="@+id/deleted_vehi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차량 번호"
            android:layout_weight="1"
            android:textColor="#BEBEBE"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_regulared"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@id/layout_deleted_vehi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- 오른쪽 Value -->
        <TextView
            android:id="@+id/deleted_vehi_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="25dp"
            android:textColor="@color/white"
            android:text="GV80"
            android:layout_marginTop="10dp"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_bolded"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_delete_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/layout_deleted_vehi"
        >

        <!-- 왼쪽 Label -->
        <TextView
            android:id="@+id/delete_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제 유형"
            android:layout_weight="1"
            android:textColor="#BEBEBE"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@id/layout_deleted_vehi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- 오른쪽 Value -->
        <TextView
            android:id="@+id/delete_mode_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"

            android:layout_marginTop="10dp"
            android:textColor="@color/white"
            android:text="GV80"
            android:layout_marginEnd="25dp"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_bolded"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_deleted_odometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/layout_delete_mode"
        >

        <!-- 왼쪽 Label -->
        <TextView
            android:id="@+id/deleted_credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 주행거리"
            android:layout_weight="1"
            android:textColor="#BEBEBE"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@id/deleted_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp"/>

        <!-- 오른쪽 Value -->
        <TextView
            android:id="@+id/deleted_odometer_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginEnd="25dp"
            android:textColor="@color/white"
            android:text="GV80"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_bolded"/>
    </LinearLayout>



    <View
        android:id="@+id/deleted_line2"
        android:layout_width="match_parent"
        android:layout_height="1.5px"
        android:background="#BEBEBE"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/layout_deleted_odometer"/>


        <TextView
        android:id="@+id/final_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="위 사항으로 개인정보 삭제 프로세스가 시작됩니다."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:lineSpacingExtra ="5dp"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        app:layout_constraintTop_toBottomOf="@id/deleted_line2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

