    <TextView
        android:id="@+id/select_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:text="삭제를 진행하기 앞서 소요 시간을 \n선택 해주세요"
        android:fontFamily="@font/roboto_bolded"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo" />



    <TextView
        android:id="@+id/select_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:text="'Normal'의 경우 완전 삭제를 진행하며 \n 전체소요시간이 오래걸릴 수 있습니다.\n 'Short'의 경우 부분 삭제를 진행하지만\n 전체소요시간이 줄어들 수 있습니다."
        android:fontFamily="@font/roboto_regulared"
        android:lineSpacingExtra ="5dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/select_title"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <Button
            android:id="@+id/normal_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Normal"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/roboto_regular"
            android:background="@drawable/gray_button"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <!-- 수직선 -->
        <View
            android:layout_width="25px"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/short_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Short"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/roboto_regular"
            android:background="@drawable/button_background_rounded"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>