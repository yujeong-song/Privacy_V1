<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.ReConnectionActivity">

    <!-- ACAT 로고 -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="200dp"
        android:layout_height="71dp"
        android:layout_marginTop="50dp"
        android:background="#00000000"
        android:contentDescription="Logo"
        android:gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/acat_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 가운데 아이콘 -->
    <ImageView
        android:id="@+id/center_icon"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/blt_icon"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="130dp"/>

    <TextView
        android:id="@+id/fail_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="차량 연결에 실패 했습니다."
        android:textColor="#798EE5"
        android:textSize="22sp"
        android:fontFamily="@font/roboto_bolded"
        app:layout_constraintTop_toBottomOf="@id/center_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="26dp"/>

    <TextView
        android:id="@+id/fail_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="차량 연결이 끊겨 재연결이 필요합니다. \n 차량 정보를 다시 확인합니다."
        android:textColor="@color/white"
        android:lineSpacingExtra ="4dp"
        android:textSize="19sp"
        android:fontFamily="@font/roboto_regular"
        app:layout_constraintTop_toBottomOf="@id/fail_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="26dp"/>


    <Button
        android:id="@+id/reconnectionButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/button_background_rounded"
        android:clickable="true"
        android:textAllCaps="true"

        android:layout_marginTop="40dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:gravity="center"
        android:text="차량 정보 재확인"
        android:textColor="@color/white"
        android:fontFamily="@font/roboto_regular"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/fail_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>





</androidx.constraintlayout.widget.ConstraintLayout>