    <TextView
        android:id="@+id/vehi_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:text="차량 번호"
        android:fontFamily="@font/roboto_bolded"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo" />

    <EditText
        android:id="@+id/editVehiNum"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="15dp"
        android:ems="10"
        android:textColor="@color/white"
        android:hint="차량 번호를 입력해주세요."
        android:textColorHint="#898989"
        android:inputType="textPersonName"
        android:text=""
        android:backgroundTint="#3A3B76"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vehi_label"/>

    <TextView
        android:id="@+id/tot_dist_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:text="총 주행거리"
        android:fontFamily="@font/roboto_bolded"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editVehiNum" />

    <EditText
        android:id="@+id/tot_dist"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="15dp"
        android:ems="10"
        android:textColor="@color/white"
        android:hint="총 주행거리를 입력해주세요."
        android:textColorHint="#898989"
        android:inputType="textPersonName"
        android:text=""
        android:backgroundTint="#3A3B76"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tot_dist_label"/>


    <TextView
        android:id="@+id/delete_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:text="삭제 유형"
        android:fontFamily="@font/roboto_bolded"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tot_dist" />

    <LinearLayout
        android:id="@+id/button_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/delete_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <!-- 첫 번째 버튼 -->
        <LinearLayout
            android:id="@+id/btn_pro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/privacy_mode_selector"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/pro_icon"
                android:duplicateParentState="true"
                android:background="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pro(약 30분)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/roboto_bolded"
                android:layout_marginTop="10dp"
                android:duplicateParentState="true"
                android:background="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차량 내 저장된 데이터를 \n전체 삭제합니다. \n차량 환경에 따라 약 30분이 \n소요될 수 있습니다. "
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/roboto_regulared"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra ="3dp"
                android:duplicateParentState="true"
                android:background="@null"/>
        </LinearLayout>

        <!-- 두 번째 버튼 -->
        <LinearLayout
            android:id="@+id/btn_standard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/privacy_mode_selector"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/standard_icon"
                android:duplicateParentState="true"
                android:background="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard(약 15분)"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/roboto_bolded"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:duplicateParentState="true"
                android:background="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차량에 저장된 주요 데이터만 \n빠르게 삭제합니다.\n차량 환경에 따라 약 15분이 \n소요될 수 있습니다. "
                android:textColor="#FFFFFF"
                android:lineSpacingExtra ="3dp"
                android:textSize="16sp"
                android:fontFamily="@font/roboto_regulared"
                android:layout_marginTop="10dp"
                android:duplicateParentState="true"
                android:background="@null"/>

        </LinearLayout>

    </LinearLayout>

